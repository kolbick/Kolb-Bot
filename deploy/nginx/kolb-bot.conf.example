# Reverse proxy example for kolb-bot.com -> local Kolb-Bot container.
# TLS certificates are managed on the host (e.g. certbot); never baked into
# the application image.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name kolb-bot.com;

    ssl_certificate     /etc/letsencrypt/live/kolb-bot.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kolb-bot.com/privkey.pem;

    client_max_body_size 100M;

    # Basic rate limiting for the auth endpoints.
    location /api/v1/auths/ {
        limit_req zone=kolbbot_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3101;
        include /etc/nginx/snippets/kolb-bot-proxy-headers.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:3101;

        # Standard forwarded headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (chat streaming, terminal sessions)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}

server {
    listen 80;
    server_name kolb-bot.com;
    return 301 https://$host$request_uri;
}

# In the http{} block:
#   limit_req_zone $binary_remote_addr zone=kolbbot_auth:10m rate=5r/m;
