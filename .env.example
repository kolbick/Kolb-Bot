# Kolb-Bot deployment configuration — public example values only.
# Copy to `.env` and generate real secrets during deployment:
#   openssl rand -hex 32
# Never commit the real `.env`.

# --- Product identity ---
PRODUCT_NAME=Kolb-Bot
PRODUCT_SHORT_NAME=Kolb-Bot
PRODUCT_SLUG=kolb-bot
PRIMARY_DOMAIN=kolb-bot.com

# --- App service ---
APP_HOST_PORT=3101
APP_CONTAINER_NAME=kolb-bot
APP_DATA_VOLUME=kolb-bot-data
# REQUIRED: unique session/signing secret. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Set to the reverse proxy's address(es) in production.
FORWARDED_ALLOW_IPS=127.0.0.1
ENABLE_SIGNUP=false
BUILD_HASH=dev-build

# --- Providers ---
# Ollama on the host (Linux host-gateway mapping is configured in compose):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# --- Kolb Terminal (optional service) ---
# Enable by adding the profile:  COMPOSE_PROFILES=terminal
# Disable at any time by clearing COMPOSE_PROFILES — no rebuild needed. The
# in-app connection can also be toggled with TERMINAL_ENABLED.
COMPOSE_PROFILES=
TERMINAL_ENABLED=false
TERMINAL_CONTAINER_NAME=kolb-terminal
TERMINAL_DATA_VOLUME=kolb-terminal-data
TERMINAL_DISPLAY_NAME=Kolb Terminal
TERMINAL_INTERNAL_PORT=8080
# Pin the upstream Open Terminal source ref to build from (tag or commit).
TERMINAL_SOURCE_REF=main
# REQUIRED when the terminal is enabled. Generate with: openssl rand -hex 32
# Server-side only — never exposed to the browser.
TERMINAL_API_KEY=

# --- Kolb Computer (CPTR gateway, optional) ---
# CPTR runs on the host or as a separately managed container; connect via its
# OpenAI-compatible gateway. See docs/CPTR_INTEGRATION.md. Treat access like
# SSH access to the host — never expose it publicly.
COMPUTER_DISPLAY_NAME=Kolb Computer
# CPTR_GATEWAY_URL=http://host.docker.internal:8100/v1
CPTR_GATEWAY_URL=
CPTR_GATEWAY_KEY=
