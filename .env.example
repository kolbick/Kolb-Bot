# Kolb-Bot deployment configuration — public example values only.
# Copy to `.env` and generate real secrets during deployment:
#   openssl rand -hex 32
# Never commit the real `.env`.

# --- Product identity ---
PRODUCT_NAME=Kolb-Bot
PRODUCT_SHORT_NAME=Kolb-Bot
PRODUCT_SLUG=kolb-bot
PRIMARY_DOMAIN=kolb-bot.com

# --- App service ---
APP_HOST_PORT=3101
APP_CONTAINER_NAME=kolb-bot
APP_DATA_VOLUME=kolb-bot-data
# REQUIRED: unique session/signing secret. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Set to the reverse proxy's address(es) in production.
FORWARDED_ALLOW_IPS=127.0.0.1
ENABLE_SIGNUP=false
BUILD_HASH=dev-build

# --- Providers ---
# Ollama on the host (Linux host-gateway mapping is configured in compose):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# --- Kolb Terminal ---
# On by default: every user gets their own isolated terminal (separate Linux
# account + home directory inside the kolb-terminal container — see
# docs/OPEN_TERMINAL.md). Disable entirely by clearing COMPOSE_PROFILES, or
# keep the service running but disconnect it from the app with
# TERMINAL_ENABLED=false — neither requires a rebuild.
COMPOSE_PROFILES=terminal
TERMINAL_ENABLED=true
TERMINAL_MULTI_USER=true
TERMINAL_CONTAINER_NAME=kolb-terminal
TERMINAL_DATA_VOLUME=kolb-terminal-data
TERMINAL_DISPLAY_NAME=Kolb Terminal
TERMINAL_INTERNAL_PORT=8000
# Pin the upstream Open Terminal source ref to build from (tag or commit).
TERMINAL_SOURCE_REF=v0.11.34
# REQUIRED. Generate with: openssl rand -hex 32. Server-side only — never
# exposed to the browser.
TERMINAL_API_KEY=

# --- Kolb Computer (CPTR gateway) ---
# CPTR itself is NOT part of this stack — it's a separate, licensed product
# you run on the host or as your own container (see docs/CPTR_INTEGRATION.md
# for the licensing boundary). Set the two values below and it comes
# connected automatically on next restart, with no manual Admin Settings
# step: the app wires it in as an OpenAI-compatible connection at startup.
# It is admin-only by default — regular users won't see or be able to use it
# until an admin explicitly grants access (Workspace > Models). Leave
# CPTR_GATEWAY_URL empty to skip this entirely; normal chat is unaffected
# either way. Treat access like SSH access to the host — never expose it
# publicly.
COMPUTER_DISPLAY_NAME=Kolb Computer
# CPTR_GATEWAY_URL=http://host.docker.internal:8100/v1
CPTR_GATEWAY_URL=
CPTR_GATEWAY_KEY=
